 "s": 45.22, "e": 45.48}, {"w": " blood", "s": 45.48, "e": 45.86}, {"w": " generally", "s": 45.86, "e": 46.44}, {"w": " means", "s": 46.44, "e": 46.8}, {"w": " more", "s": 46.8, "e": 47.2}, {"w": " green", "s": 47.2, "e": 47.5}, {"w": " light", "s": 47.5, "e": 47.74}, {"w": " absorbed,", "s": 47.74, "e": 48.18}]}, {"s": 48.46, "e": 49.48, "text": "so less returns.", "words": [{"w": " so", "s": 48.46, "e": 48.8}, {"w": " less", "s": 48.8, "e": 49.06}, {"w": " returns.", "s": 49.06, "e": 49.48}]}, {"s": 49.96, "e": 52.36, "text": "Between pulses, the pattern reverses.", "words": [{"w": " Between", "s": 49.96, "e": 50.32}, {"w": " pulses,", "s": 50.32, "e": 50.78}, {"w": " the", "s": 51.08, "e": 51.16}, {"w": " pattern", "s": 51.16, "e": 51.44}, {"w": " reverses.", "s": 51.44, "e": 52.36}]}, {"s": 52.68, "e": 57.1, "text": "Tiny changes repeated over time create a wave the watch can analyze.", "words": [{"w": " Tiny", "s": 52.68, "e": 53.04}, {"w": " changes", "s": 53.04, "e": 53.5}, {"w": " repeated", "s": 53.5, "e": 54.1}, {"w": " over", "s": 54.1, "e": 54.42}, {"w": " time", "s": 54.42, "e": 54.78}, {"w": " create", "s": 54.78, "e": 55.28}, {"w": " a", "s": 55.28, "e": 55.68}, {"w": " wave", "s": 55.68, "e": 56.0}, {"w": " the", "s": 56.0, "e": 56.26}, {"w": " watch", "s": 56.26, "e": 56.42}, {"w": " can", "s": 56.42, "e": 56.72}, {"w": " analyze.", "s": 56.72, "e": 57.1}]}, {"s": 57.1, "e": 61.72, "text": "Hindi ibig sabihin na bawat flash ng ilaw ay isang heartbeat.", "words": [{"w": " Hindi", "s": 57.1, "e": 58.14}, {"w": " ibig", "s": 58.14, "e": 58.42}, {"w": " sabihin", "s": 58.42, "e": 58.88}, {"w": " na", "s": 58.88, "e": 59.1}, {"w": " bawat", "s": 59.1, "e": 59.46}, {"w": " flash", "s": 59.46, "e": 59.86}, {"w": " ng", "s": 59.86, "e": 60.1}, {"w": " ilaw", "s": 60.1, "e": 60.56}, {"w": " ay", "s": 60.56, "e": 60.78}, {"w": " isang", "s": 60.78, "e": 61.26}, {"w": " heartbeat.", "s": 61.26, "e": 61.72}]}, {"s": 62.28, "e": 64.76, "text": "The LEDs can flash much faster than your pulse.", "words": [{"w": " The", "s": 62.28, "e": 62.34}, {"w": " LEDs", "s": 62.34, "e": 62.76}, {"w": " can", "s": 62.76, "e": 63.04}, {"w": " flash", "s": 63.04, "e": 63.38}, {"w": " much", "s": 63.38, "e": 63.7}, {"w": " faster", "s": 63.7, "e": 64.12}, {"w": " than", "s": 64.12, "e": 64.28}, {"w": " your", "s": 64.28, "e": 64.46}, {"w": " pulse.", "s": 64.46, "e": 64.76}]}, {"s": 65.34, "e": 69.5, "text": "The watch takes many samples, and software looks for the repeating pulse pattern.", "words": [{"w": " The", "s": 65.34, "e": 65.44}, {"w": " watch", "s": 65.44, "e": 65.68}, {"w": " takes", "s": 65.68, "e": 66.04}, {"w": " many", "s": 66.04, "e": 66.46}, {"w": " samples,", "s": 66.46, "e": 66.94}, {"w": " and", "s": 67.12, "e": 67.34}, {"w": " software", "s": 67.34, "e": 67.76}, {"w": " looks", "s": 67.76, "e": 68.1}, {"w": " for", "s": 68.1, "e": 68.34}, {"w": " the", "s": 68.34, "e": 68.46}, {"w": " repeating", "s": 68.46, "e": 68.8}, {"w": " pulse", "s": 68.8, "e": 69.1}, {"w": " pattern.", "s": 69.1, "e": 69.5}]}, {"s": 70.16, "e": 75.24, "text": "If that pattern repeats once every second, that corresponds to 60 beats per minute.", "words": [{"w": " If", "s": 70.16, "e": 70.34}, {"w": " that", "s": 70.34, "e": 70.58}, {"w": " pattern", "s": 70.58, "e": 70.92}, {"w": " repeats", "s": 70.92, "e": 71.32}, {"w": " once", "s": 71.32, "e": 71.84}, {"w": " every", "s": 71.84, "e": 72.16}, {"w": " second,", "s": 72.16, "e": 72.52}, {"w": " that", "s": 72.84, "e": 73.06}, {"w": " corresponds", "s": 73.06, "e": 73.56}, {"w": " to", "s": 73.56, "e": 73.92}, {"w": " 60", "s": 73.92, "e": 74.36}, {"w": " beats", "s": 74.36, "e": 74.68}, {"w": " per", "s": 74.68, "e": 74.94}, {"w": " minute.", "s": 74.94, "e": 75.24}]}, {"s": 75.7, "e": 77.76, "text": "Twice every second would be 120.", "words": [{"w": " Twice", "s": 75.7, "e": 76.04}, {"w": " every", "s": 76.04, "e": 76.32}, {"w": " second", "s": 76.32, "e": 76.7}, {"w": " would", "s": 76.7, "e": 76.96}, {"w": " be", "s": 76.96, "e": 77.2}, {"w": " 120.", "s": 77.2, "e": 77.76}]}, {"s": 78.24, "e": 80.3, "text": "These are examples, not target numbers.", "words": [{"w": " These", "s": 78.24, "e": 78.5}, {"w": " are", "s": 78.5, "e": 78.74}, {"w": " examples,", "s": 78.74, "e": 79.08}, {"w": " not", "s": 79.32, "e": 79.64}, {"w": " target", "s": 79.64, "e": 79.94}, {"w": " numbers.", "s": 79.94, "e": 80.3}]}, {"s": 81.0, "e": 81.96, "text": "Pero may challenge.", "words": [{"w": " Pero", "s": 81.0, "e": 81.22}, {"w": " may", "s": 81.22, "e": 81.46}, {"w": " challenge.", "s": 81.46, "e": 81.96}]}, {"s": 82.4, "e": 86.6, "text": "Moving your wrist or letting the watch slide can also change the light signal.", "words": [{"w": " Moving", "s": 82.4, "e": 82.66}, {"w": " your", "s": 82.66, "e": 82.98}, {"w": " wrist", "s": 82.98, "e": 83.28}, {"w": " or", "s": 83.28, "e": 83.62}, {"w": " letting", "s": 83.62, "e": 83.88}, {"w": " the", "s": 83.88, "e": 84.12}, {"w": " watch", "s": 84.12, "e": 84.32}, {"w": " slide", "s": 84.32, "e": 84.86}, {"w": " can", "s": 84.86, "e": 85.22}, {"w": " also", "s": 85.22, "e": 85.56}, {"w": " change", "s": 85.56, "e": 85.88}, {"w": " the", "s": 85.88, "e": 86.1}, {"w": " light", "s": 86.1, "e": 86.26}, {"w": " signal.", "s": 86.26, "e": 86.6}]}, {"s": 86.6, "e": 91.72, "text": "Cold skin can reduce blood flow near the surface, making the pulse harder to detect.", "words": [{"w": " Cold", "s": 86.6, "e": 87.48}, {"w": " skin", "s": 87.48, "e": 87.86}, {"w": " can", "s": 87.86, "e": 88.16}, {"w": " reduce", "s": 88.16, "e": 88.48}, {"w": " blood", "s": 88.48, "e": 88.78}, {"w": " flow", "s": 88.78, "e": 88.94}, {"w": " near", "s": 88.94, "e": 89.12}, {"w": " the", "s": 89.12, "e": 89.36}, {"w": " surface,", "s": 89.36, "e": 89.7}, {"w": " making", "s": 89.94, "e": 90.32}, {"w": " the", "s": 90.32, "e": 90.52}, {"w": " pulse", "s": 90.52, "e": 90.74}, {"w": " harder", "s": 90.74, "e": 91.16}, {"w": " to", "s": 91.16, "e": 91.42}, {