[{"s": 0.0, "e": 3.4, "text": "Paano nalalaman ng smartwatch ang tibok ng puso mo?", "words": [{"w": " Paano", "s": 0.0, "e": 0.64}, {"w": " nalalaman", "s": 0.64, "e": 1.22}, {"w": " ng", "s": 1.22, "e": 1.42}, {"w": " smartwatch", "s": 1.42, "e": 2.06}, {"w": " ang", "s": 2.06, "e": 2.3}, {"w": " tibok", "s": 2.3, "e": 2.64}, {"w": " ng", "s": 2.64, "e": 2.8}, {"w": " puso", "s": 2.8, "e": 3.14}, {"w": " mo?", "s": 3.14, "e": 3.4}]}, {"s": 3.86, "e": 5.74, "text": "Gamit lang ang ilaw!", "words": [{"w": " Gamit", "s": 3.86, "e": 4.22}, {"w": " lang", "s": 4.22, "e": 4.42}, {"w": " ang", "s": 4.42, "e": 4.64}, {"w": " ilaw!", "s": 4.64, "e": 5.74}]}, {"s": 6.02, "e": 7.06, "text": "Look underneath your watch.", "words": [{"w": " Look", "s": 6.02, "e": 6.06}, {"w": " underneath", "s": 6.06, "e": 6.48}, {"w": " your", "s": 6.48, "e": 6.7}, {"w": " watch.", "s": 6.7, "e": 7.06}]}, {"s": 7.6, "e": 12.9, "text": "Those green lights are part of a system called photoplethysmography, or PPG.", "words": [{"w": " Those", "s": 7.6, "e": 7.6}, {"w": " green", "s": 7.6, "e": 8.02}, {"w": " lights", "s": 8.02, "e": 8.38}, {"w": " are", "s": 8.38, "e": 8.58}, {"w": " part", "s": 8.58, "e": 8.82}, {"w": " of", "s": 8.82, "e": 8.98}, {"w": " a", "s": 8.98, "e": 9.08}, {"w": " system", "s": 9.08, "e": 9.38}, {"w": " called", "s": 9.38, "e": 9.8}, {"w": " photoplethysmography,", "s": 9.8, "e": 11.34}, {"w": " or", "s": 11.66, "e": 12.04}, {"w": " PPG.", "s": 12.04, "e": 12.9}]}, {"s": 13.12, "e": 15.22, "text": "Mahabang pangalan, pero simple ang idea.", "words": [{"w": " Mahabang", "s": 13.12, "e": 13.52}, {"w": " pangalan,", "s": 13.52, "e": 13.98}, {"w": " pero", "s": 14.04, "e": 14.28}, {"w": " simple", "s": 14.28, "e": 14.66}, {"w": " ang", "s": 14.66, "e": 14.8}, {"w": " idea.", "s": 14.8, "e": 15.22}]}, {"s": 15.56, "e": 18.8, "text": "Your pulse changes how much light comes back from your skin.", "words": [{"w": " Your", "s": 15.56, "e": 15.86}, {"w": " pulse", "s": 15.86, "e": 16.24}, {"w": " changes", "s": 16.24, "e": 16.7}, {"w": " how", "s": 16.7, "e": 16.98}, {"w": " much", "s": 16.98, "e": 17.3}, {"w": " light", "s": 17.3, "e": 17.58}, {"w": " comes", "s": 17.58, "e": 17.9}, {"w": " back", "s": 17.9, "e": 18.14}, {"w": " from", "s": 18.14, "e": 18.34}, {"w": " your", "s": 18.34, "e": 18.56}, {"w": " skin.", "s": 18.56, "e": 18.8}]}, {"s": 19.5, "e": 21.68, "text": "The watch shines light into your wrist.", "words": [{"w": " The", "s": 19.5, "e": 19.78}, {"w": " watch", "s": 19.78, "e": 20.08}, {"w": " shines", "s": 20.08, "e": 20.5}, {"w": " light", "s": 20.5, "e": 20.82}, {"w": " into", "s": 20.82, "e": 21.12}, {"w": " your", "s": 21.12, "e": 21.4}, {"w": " wrist.", "s": 21.4, "e": 21.68}]}, {"s": 22.06, "e": 26.84, "text": "Some gets absorbed and some scatters back toward a light detector called a photodiode.", "words": [{"w": " Some", "s": 22.06, "e": 22.3}, {"w": " gets", "s": 22.3, "e": 22.56}, {"w": " absorbed", "s": 22.56, "e": 23.04}, {"w": " and", "s": 23.04, "e": 23.36}, {"w": " some", "s": 23.36, "e": 23.72}, {"w": " scatters", "s": 23.72, "e": 24.28}, {"w": " back", "s": 24.28, "e": 24.42}, {"w": " toward", "s": 24.42, "e": 24.64}, {"w": " a", "s": 24.64, "e": 24.9}, {"w": " light", "s": 24.9, "e": 25.08}, {"w": " detector", "s": 25.08, "e": 25.44}, {"w": " called", "s": 25.44, "e": 25.9}, {"w": " a", "s": 25.9, "e": 26.3}, {"w": " photodiode.", "s": 26.3, "e": 26.84}]}, {"s": 27.18, "e": 28.92, "text": "It measures light intensity.", "words": [{"w": " It", "s": 27.18, "e": 27.52}, {"w": " measures", "s": 27.52, "e": 27.9}, {"w": " light", "s": 27.9, "e": 28.34}, {"w": " intensity.", "s": 28.34, "e": 28.92}]}, {"s": 28.92, "e": 30.7, "text": "not a picture of your veins.", "words": [{"w": " not", "s": 28.92, "e": 29.52}, {"w": " a", "s": 29.52, "e": 29.8}, {"w": " picture", "s": 29.8, "e": 30.02}, {"w": " of", "s": 30.02, "e": 30.16}, {"w": " your", "s": 30.16, "e": 30.34}, {"w": " veins.", "s": 30.34, "e": 30.7}]}, {"